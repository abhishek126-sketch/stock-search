897000],["2026-03-31",4033000]],"quarterlyDilutedEPS":[],"annualResearchAndDevelopment":[],"quarterlyOperatingIncome":[],"quarterlyTotalRevenue":[],"annualInventory":[],"quarterlyNetIncome":[]},"vol":{"avg50":17304,"last":385200,"udr":2.198},"fx":null,"profile":{"industry":"Software - Application","sector":"Technology","insiders":0.71314,"institutions":0,"shares":15637020,"bookValue":37.893,"ocfTTM":-7835000,"fcfTTM":-163764256,"cash":40737000,"debt":29736000,"opMargins":0.26823,"profitMargins":0.19325,"beta":null,"currentRatio":4.017,"revGrowth":-0.141,"earnGrowth":-0.531,"fwdEps":null,"peg":null,"grossMargins":0.45683998,"summary":"Icodex Publishing Solutions Limited provides software solutions to the scholarly and academic publishing industries in India. It offers Innovative Comprehensive Automated Publishing Platform, a cloud-based publishing workflow solution that streamlines the publishing process through the workflow and communication management, data transfer, and data storage; PaperPerfect, a manuscript refinement platform designed to support researchers, universities, and research institutions; eAssistant, a manuscript assessment system to meet publisher and journal-level requirements; and iProof, an online review and editing platform. The company also provides FlexyPage, an advanced HTML-based online layout processing system; Intelligent Mechanical and Technical Editing System, which is designed to convert word manuscripts into structured XML; iLang, an advanced language assessment and editing platform; iRef, an automated reference management platform that verifies, updates, and restructures references based on the required style; Product Data Hub and MetaScholar, which manages product and production specifications throughout the entire life cycle of an article or book; iPublish, a cloud-based digital library designed for the dissemination of publishing content; and ieBooks for digitizing books into popular formats, such as Kindle, Mobi, and iBook applica